# Pi Agent 服务
PI_HOST=0.0.0.0
PI_PORT=3000
PI_MODEL=claude-sonnet-4-6
PI_MAX_TOKENS=1024
PI_THINKING_LEVEL=off
PI_LLM_ROUTING=true
PI_EMBEDDING_INTENT=true
PI_EMBEDDING_INTENT_TOP_K=3
PI_EMBEDDING_INTENT_THRESHOLD=0.55
PI_GENERAL_REPLICAS=1
PI_TECHNICAL_REPLICAS=1
PI_BILLING_REPLICAS=1
PI_TOOL_TRACE_MAX=200
PI_MONITOR_FALLBACK_PENALTY=0.5

# Anthropic 或 Anthropic Messages 兼容服务
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 双服务互连（本地开发默认值；Compose 会覆盖为容器服务名）
PYTHON_INFRA_URL=http://localhost:8000
PI_AGENT_URL=http://localhost:3000
PYTHON_INFRA_TIMEOUT_MS=10000

# Python 业务基础设施
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000
REDIS_URL=redis://:lumenmind123@localhost:6379/0
REDIS_PASSWORD=lumenmind123
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
EVAL_BASELINE_PATH=./data/eval/baseline.json

# Skills 与知识检索
LUMENMIND_SKILLS_DIR=./skills
LUMENMIND_SKILLS_MAX_PROMPT_CHARS=5000
KNOWLEDGE_QUERY_REWRITE=false
LOG_LEVEL=INFO

# SQLite 记忆权威存储与上下文预算
MEMORY_DB_PATH=data/memory/memory.sqlite3
MEMORY_NAMESPACE=lumenmind
MEMORY_LONG_TERM_ENABLED=true
MEMORY_EPISODIC_ENABLED=true
MEMORY_CONTEXT_MAX_CHARS=24000
MEMORY_SUMMARY_TRIGGER_CHARS=18000
MEMORY_SUMMARY_TRIGGER_TURNS=12
MEMORY_RECENT_MIN_TURNS=3
MEMORY_SUMMARY_MAX_CHARS=4000
MEMORY_FACT_BLOCK_MAX_CHARS=3000
MEMORY_EPISODE_BLOCK_MAX_CHARS=3000
MEMORY_FACT_MAX_COUNT=50
MEMORY_FACT_MAX_CHARS=300
MEMORY_EXTRACT_MIN_MESSAGES=3
MEMORY_EXTRACT_MAX_MESSAGES=20
MEMORY_EXTRACT_MAX_CHARS=12000
MEMORY_EXTRACT_MAX_WAIT_SECONDS=60
MEMORY_MODEL_TIMEOUT_SECONDS=30
MEMORY_JOB_LEASE_SECONDS=180
MEMORY_JOB_MAX_ATTEMPTS=3
MEMORY_SESSION_LEASE_SECONDS=90
MEMORY_WORKER_POLL_SECONDS=5
# 新链路直接读取 SQLite；Redis 版本化渲染缓存尚未启用。
# MEMORY_CACHE_TTL_SECONDS=86400
MEMORY_MODEL_CONTEXT_WINDOW_TOKENS=65536
MEMORY_MODEL_MAX_INPUT_CHARS=24000
PI_MEMORY_ROUTING_MAX_CHARS=2000
PI_TOOL_RESULT_MAX_CHARS=8000
